#!/bin/bash
# TB250 NVIDIA driver switch for the SGL driver experiments.
#
# Install (once, as root; the script and the installers must be root-owned so
# that the NOPASSWD rule below cannot be used to run anything else):
#   install -o root -g root -m 0755 sgl-driver-switch /usr/local/sbin/sgl-driver-switch
#   install -d -o root -g root -m 0755 /usr/local/lib/sgl-driver
#   install -o root -g root -m 0644 ~/bench/nvidia/NVIDIA-Linux-x86_64-390.157.run \
#       ~/bench/nvidia/NVIDIA-470.run /usr/local/lib/sgl-driver/
#   echo 'eightman ALL=(root) NOPASSWD: /usr/local/sbin/sgl-driver-switch' > /etc/sudoers.d/sgl-driver
#   chmod 0440 /etc/sudoers.d/sgl-driver && visudo -cf /etc/sudoers.d/sgl-driver
#
# Usage: sudo sgl-driver-switch <status|nv390|nv470|nouveau|nv470-nouveau430> [--reinstall-userspace]
#        sudo sgl-driver-switch pstate <show|set <pstate-id> <pci>>   (nouveau cards only; reclock via debugfs)
#        sudo sgl-driver-switch perf <auto|high|pin|compute>   (AMD cards only; pin = manual top sclk/mclk)
#   nv390             390.157 for all three cards (the boot default; the restore target)
#   nv470             470 for the Kepler cards; the GT 430 is left without a driver
#   nouveau           nouveau (modeset=1) for all three cards, for rusticl / NVK
#   nv470-nouveau430  470 for the Kepler cards, nouveau for the GT 430
# After a reboot the 390 kernel module loads again; run `nv390` before using
# CUDA / OpenCL if the last state installed the 470 userspace (`status` prints a WARNING when the
# userspace libcuda and the loaded kernel module differ).
# The nvidia userspace is skipped when $LIB/userspace.installed already names the same .run;
# --reinstall-userspace forces it. The nouveau modeset value is $NOUVEAU_MODESET (1 default, 2 = headless);
# sudo does not pass the environment, so edit the default below for a different value.

set -Eeuo pipefail
LIB=/usr/local/lib/sgl-driver
RUN390=$LIB/NVIDIA-Linux-x86_64-390.157.run
RUN470=$LIB/NVIDIA-470.run
STATE=/run/sgl-driver.state
USMARK=$LIB/userspace.installed
NOUVEAU_MODESET=${NOUVEAU_MODESET:-1}
FORCE_US=0; [ "${2:-}" = --reinstall-userspace ] && FORCE_US=1
GT430=0000:04:00.0
KEPLER=(0000:07:00.0 0000:08:00.0)
ALL=("$GT430" "${KEPLER[@]}")
AMD=(0000:03:00.0 0000:06:00.0)  # RX 6400, WX 2100

[ "$(id -u)" = 0 ] || { echo "run with sudo" >&2; exit 2; }
log() { echo "[sgl-driver] $*"; }
# A failed step leaves a half-switched machine; record that instead of the old state name.
trap 'rc=$?; echo "failed($rc) at line $LINENO: $BASH_COMMAND" > "$STATE"; echo "[sgl-driver] FAILED at line $LINENO (rc=$rc); state recorded as failed. Run status, then nv390 (or reboot)." >&2' ERR

status() {
    for d in "${ALL[@]}"; do
        drv=$(basename "$(readlink -f /sys/bus/pci/devices/$d/driver 2>/dev/null)" 2>/dev/null || true)
        echo "$d ${drv:-none}"
    done
    lsmod | grep -E '^(nvidia|nouveau)' || true
    for d in "${AMD[@]}"; do
        echo "$d perf=$(cat /sys/bus/pci/devices/$d/power_dpm_force_performance_level 2>/dev/null || echo n/a)"
    done
    [ -f "$STATE" ] && echo "state: $(cat "$STATE")" || echo "state: unknown (boot default)"
    cat /proc/driver/nvidia/version 2>/dev/null | head -1 || true
    for d in "${ALL[@]}"; do
        echo "$d nodes: $(ls /sys/bus/pci/devices/$d/drm 2>/dev/null | tr '\n' ' ')"
    done
    [ -r /sys/module/nouveau/parameters/modeset ] && echo "nouveau modeset=$(cat /sys/module/nouveau/parameters/modeset)"
    local lc kv
    lc=$(readlink -f /usr/lib/x86_64-linux-gnu/libcuda.so.1 2>/dev/null | sed 's/.*libcuda\.so\.//')
    kv=$(awk '/NVRM version/ {for (i=1;i<=NF;i++) if ($i ~ /^[0-9]+\.[0-9]+/) {print $i; exit}}' /proc/driver/nvidia/version 2>/dev/null)
    echo "userspace libcuda=${lc:-none} marker=$(cat "$USMARK" 2>/dev/null || echo none) kernel module=${kv:-not loaded}"
    if [ -n "$kv" ] && [ -n "$lc" ] && [ "$kv" != "$lc" ]; then echo "WARNING: userspace $lc does not match the kernel module $kv"; fi
}

busy_check() { # refuse while a process holds an NVIDIA device node or a DRM node of a GT card (fuser is not installed)
    local users n d args=(-lname '/dev/nvidia*')
    for d in "${ALL[@]}"; do   # nouveau / nvidia_drm nodes of the three cards only; the AMD nodes stay free for other benches
        for n in $(ls /sys/bus/pci/devices/$d/drm 2>/dev/null); do args+=(-o -lname "/dev/dri/$n"); done
    done
    users=$(find /proc/[0-9]*/fd "${args[@]}" 2>/dev/null | cut -d/ -f3 | sort -u | tr '\n' ' ')
    if [ -n "$users" ]; then
        echo "an NVIDIA / GT-card DRM node is in use by pid(s): $users; stop the bench first" >&2; exit 1
    fi
}

unload_all() {
    for m in nvidia_drm nvidia_modeset nvidia_uvm nvidia_peermem nvidia nouveau; do
        if lsmod | grep -q "^$m "; then log "rmmod $m"; modprobe -r "$m"; fi
    done
    for d in "${ALL[@]}"; do echo > /sys/bus/pci/devices/$d/driver_override; done
}

override() { # override <driver> <pci>...
    local drv=$1; shift
    for d in "$@"; do echo "$drv" > /sys/bus/pci/devices/$d/driver_override; done
}

userspace() { # userspace <run file>
    if [ "$FORCE_US" = 0 ] && [ "$(cat "$USMARK" 2>/dev/null)" = "$(basename "$1")" ]; then
        log "userspace already $(basename "$1"); skipped (--reinstall-userspace forces it)"; return
    fi
    log "installing userspace from $(basename "$1")"
    rm -f "$USMARK"
    sh "$1" --silent --no-kernel-module --no-x-check --no-nouveau-check \
        --no-distro-scripts --install-libglvnd 2>&1 | tail -5
    ldconfig
    basename "$1" > "$USMARK"
    log "libcuda.so.1 -> $(readlink -f /usr/lib/x86_64-linux-gnu/libcuda.so.1)"
    nvidia-modprobe -u -c=0 || true
}

load_nv() { # load_nv <390|470>
    if [ "$1" = 390 ]; then
        modprobe nvidia-legacy-390xx; modprobe nvidia-legacy-390xx-uvm
        modprobe nvidia-legacy-390xx-modeset; modprobe nvidia-legacy-390xx-drm || true
    else
        modprobe nvidia-tesla-470; modprobe nvidia-tesla-470-uvm
        modprobe nvidia-tesla-470-modeset; modprobe nvidia-tesla-470-drm || true
    fi
}

load_nouveau() {
    # /etc/modprobe.d/blacklist-nouveau.conf has `options nouveau modeset=0` (= driver disabled). modprobe -n -v on
    # tb250 shows the line "nouveau.ko.xz modeset=0 modeset=1"; the later value wins, but verify instead of trusting that.
    modprobe nouveau modeset=$NOUVEAU_MODESET
    local got; got=$(cat /sys/module/nouveau/parameters/modeset 2>/dev/null || echo missing)
    [ "$got" = "$NOUVEAU_MODESET" ] || { echo "nouveau modeset=$got (wanted $NOUVEAU_MODESET)" >&2; return 1; }
    sleep 2   # the render nodes appear asynchronously after probe
}

case "${1:-}" in
    status) status; exit 0 ;;
    perf)
        # auto / high: the plain levels. pin: manual level with the top sclk and mclk state
        # (high alone sometimes leaves the RX 6400 gfxclk following the load). compute: pin +
        # the COMPUTE power profile. auto also restores the profile that was active before pin.
        case "${2:-}" in auto|high|pin|compute) ;; *) echo "usage: $0 perf <auto|high|pin|compute>" >&2; exit 2 ;; esac
        for d in "${AMD[@]}"; do
            s=/sys/bus/pci/devices/$d
            f=$s/power_dpm_force_performance_level
            [ -w "$f" ] || continue
            prof_saved=/run/sgl-driver.profile.${d//:/_}
            case "$2" in
                auto|high)
                    echo "$2" > "$f"
                    if [ "$2" = auto ] && [ -f "$prof_saved" ]; then
                        cat "$prof_saved" > $s/pp_power_profile_mode 2>/dev/null || log "$d profile restore refused (level auto resets it)"; rm -f "$prof_saved"
                    fi ;;
                pin|compute)
                    echo manual > "$f"
                    for k in pp_dpm_sclk pp_dpm_mclk; do
                        [ -w $s/$k ] || continue
                        top=$(grep -c . $s/$k); echo $((top - 1)) > $s/$k
                    done
                    if [ "$2" = compute ] && [ -w $s/pp_power_profile_mode ]; then
                        cur=$(grep -oE '^ *[0-9]+ +[A-Z_0-9]+ *\*' $s/pp_power_profile_mode | awk '{print $1}')
                        idx=$(grep -oE '^ *[0-9]+ +COMPUTE' $s/pp_power_profile_mode | awk '{print $1}')
                        [ -n "$cur" ] && [ ! -f "$prof_saved" ] && echo "$cur" > "$prof_saved"
                        [ -n "$idx" ] && echo "$idx" > $s/pp_power_profile_mode
                    fi ;;
            esac
            log "$d perf=$(cat "$f") sclk=$(grep '\*' $s/pp_dpm_sclk | tr -d '\n') mclk=$(grep '\*' $s/pp_dpm_mclk | tr -d '\n')"
        done
        exit 0 ;;
    pstate)
        # nouveau reclocking through debugfs (root only): `pstate show` lists the pstates of every nouveau-bound card;
        # `pstate set <id> <pci>` selects one (ids as shown, e.g. 0a, or ac / dc for the AC / DC pstates).
        # Memory reclocking on GK208 has hung the GPU in a bug report (freedesktop bug 99505, GT 740M):
        # set only the card under test, with no other process using it.
        case "${2:-}" in
            show|set) ;;
            *) echo "usage: $0 pstate <show|set <id> <pci>>" >&2; exit 2 ;;
        esac
        for d in "${ALL[@]}"; do
            [ "$(basename "$(readlink -f /sys/bus/pci/devices/$d/driver 2>/dev/null)" 2>/dev/null)" = nouveau ] || continue
            [ "$2" = set ] && [ "${4:-}" != "$d" ] && continue
            card=$(ls /sys/bus/pci/devices/$d/drm 2>/dev/null | grep -m1 '^card') || continue
            f=/sys/kernel/debug/dri/${card#card}/pstate
            [ -r "$f" ] || { echo "$d: $f missing (debugfs not mounted, or nouveau without pstate)"; continue; }
            echo "== $d ($card)"; cat "$f"
            if [ "$2" = set ]; then
                [[ "${3:-}" =~ ^([0-9a-f]{2}|ac|dc)$ ]] || { echo "pstate id must be two hex digits, ac or dc" >&2; exit 2; }
                echo "$3" > "$f"; echo "-- after:"; cat "$f"
            fi
        done
        exit 0 ;;
    nv390)
        busy_check; unload_all
        override nvidia "${ALL[@]}"
        load_nv 390; userspace "$RUN390" ;;
    nv470)
        busy_check; unload_all
        override nvidia "${KEPLER[@]}"; override none "$GT430"
        load_nv 470; userspace "$RUN470" ;;
    nouveau)
        busy_check; unload_all
        override nouveau "${ALL[@]}"
        load_nouveau ;;
    nv470-nouveau430)
        busy_check; unload_all
        override nvidia "${KEPLER[@]}"; override nouveau "$GT430"
        load_nouveau; load_nv 470; userspace "$RUN470" ;;
    *) echo "usage: $0 <status|nv390|nv470|nouveau|nv470-nouveau430|perf|pstate> [--reinstall-userspace]" >&2; exit 2 ;;
esac
echo "$1" > "$STATE"
case "$1" in
    nouveau|nv470-nouveau430) log "nouveau state: use VK_ICD_FILENAMES=/usr/share/vulkan/icd.d/nouveau_icd.json (the nvidia ICD in /etc/vulkan/icd.d crashes without a matching module), NVK_I_WANT_A_BROKEN_VULKAN_DRIVER=1 on Mesa < 25.2.1, RUSTICL_ENABLE=nouveau" ;;
esac
status
