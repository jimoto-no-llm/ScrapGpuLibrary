{"test":"text:nat_code.txt","n_prompt":145,"pp_s":10.863,"pp_ts":13.3485,"n_gen":128,"tg_ts":7.6788,"tg_total_ts":7.6501,"gen":"    counts = Counter()\n    for record in records:\n        counts[record.get(key, None)] += 1\n    for value, count in sorted(counts.items(), key=lambda x: x[1], reverse=True):\n        print(f\"{count}\\t{value}\")\n\n\ndef main():\n    parser = argparse.ArgumentParser(description=\"Count occurrences of each value of a JSON key in a file.\")\n    parser.add_argument(\"path\", help=\"Path to a JSON-lines file\")\n    parser.add_argument(\"key\", help=\"The key to count\")\n    args = parser.parse_args()\n    records = load_records(args.path)\n    summarize(records"}
